{
  "name": "cuentia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest tests/unit",
    "test:rules": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "firebase:emulators": "firebase emulators:start --only auth,firestore",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "graph:build": "trail build"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.2.5",
    "firebase": "^11.7.3",
    "lucide-vue-next": "^0.511.0",
    "pinia": "^3.0.2",
    "reka-ui": "^2.2.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@firebase/rules-unit-testing": "^4.0.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.6",
    "@types/node": "^22.15.17",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.26.0",
    "eslint-plugin-vue": "^10.1.0",
    "globals": "^16.1.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.3",
    "vue-tsc": "^2.2.10"
  }
}
