# Configuración pública de Firebase Web SDK (seguridad impuesta por firestore.rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Opcional: "true" para apuntar a Firebase Emulator Suite local (Auth :9099, Firestore :8080)
VITE_FIREBASE_USE_EMULATORS=false
